@model IEnumerable<TPIntegradorBack.Models.Producto>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de productos</h1>

<div>
    <a class="btn btn-success" asp-action="Create">Crear Nuevo Producto</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Detalles)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Descripcion)
            </td>
            <td>
                @item.PrecioUnitario?.ToString("N2")
            </td>
            <td>
                @Html.DisplayFor(model => item.Stock)
            </td>
            <td>
                @Html.DisplayFor(model => item.Detalles)
            </td>
            <td>
                <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-warning btn-sm" asp-action="Details" asp-route-id="@item.Id">Ver</a>
                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
