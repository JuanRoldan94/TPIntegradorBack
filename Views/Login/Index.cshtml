@model TPIntegradorBack.ViewModels.LoginViewModel

@{
    Layout = null;
}

<h2>Login</h2>

<form asp-action="Index" method="post">

    <input asp-for="NombreUsuario" placeholder="Usuario" />
    <br>

    <input asp-for="Contrasenia" type="password" placeholder="Contraseña" />
    <br>

    <button type="submit">Ingresar</button>

</form>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}