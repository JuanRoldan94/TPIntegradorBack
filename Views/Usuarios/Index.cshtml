@model IEnumerable<TPIntegradorBack.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de usuarios</h1>

<p>
    <a asp-action="Create">Crear Nuevo Usuario</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreUsuario)
            </th>
@*             <th>
                @Html.DisplayNameFor(model => model.Contrasenia)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
@*             <th>
                @Html.DisplayNameFor(model => model.Pedidos)
            </th> *@
            <th>Pedidos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NombreUsuario)
            </td>
@*             <td>
                @Html.DisplayFor(model => item.Contrasenia)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(model => item.Role)
            </td>
            <td>
                @if (item.Pedidos != null && item.Pedidos.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var pedido in item.Pedidos)
                        {
                            <li><span>Pedido N°@pedido.PedidoId</span> - $@pedido.MontoTotal</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">Sin pedidos</span>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.UsuarioId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.UsuarioId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.UsuarioId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
