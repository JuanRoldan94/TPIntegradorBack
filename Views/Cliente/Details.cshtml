@model TPIntegradorBack.Models.Cliente

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Cliente</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RazonSocial)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RazonSocial)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DNI)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DNI)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Telefono)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Telefono)
        </dd>
        </dl>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Activo)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Activo)
            </dd>
        </dl>
        <dt class = "col-sm-2">
            Direcciones
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Direcciones != null && Model.Direcciones.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var direccion in Model.Direcciones)
                    {
                        <li> @direccion.Calle @direccion.Numero, @direccion.Localidad</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">Este cliente no tiene direcciones registradas</span>
            }
        </dd>
        <dt class="col-sm-2">
            Pedidos
        </dt>
        <dd class="col-sm-10">
            @if (Model.Pedidos != null && Model.Pedidos.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var pedido in Model.Pedidos)
                    {
                        <li>Pedido @pedido.Fecha - Total: $@pedido.MontoTotal</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No hay pedidos registrados.</span>
            }
        </dd>

        </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Pedidos)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Pedidos)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ClienteId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
