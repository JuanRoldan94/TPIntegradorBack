@model TPIntegradorBack.Models.Cliente

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar cliente</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ClienteId" />
            <div class="mb-3">
                <label asp-for="RazonSocial" class="form-label"></label>
                <input asp-for="RazonSocial" class="form-control" />
                <span asp-validation-for="RazonSocial" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNI" class="form-label"></label>
                <input asp-for="DNI" class="form-control" />
                <span asp-validation-for="DNI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label"></label>
                <span asp-validation-for="Activo" class="text-danger"></span>
            </div>
@*             <div class="mb-3">
                <label asp-for="Direcciones" class="form-label"></label>
                <input asp-for="Direcciones" class="form-control" />
                <span asp-validation-for="Direcciones" class="text-danger"></span>
            </div> *@
            @* <div class="mb-3">
                <label asp-for="Pedidos" class="form-label"></label>
                <input asp-for="Pedidos" class="form-control" />
                <span asp-validation-for="Pedidos" class="text-danger"></span>
            </div> *@
            <div class="mb-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
