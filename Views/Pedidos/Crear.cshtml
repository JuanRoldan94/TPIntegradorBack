@{
    ViewData["Title"] = "Generar Despacho";
}
<style>
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }
</style>


<div class="container mt-4">
    <h2>Registro de Productos Despachados</h2>
    <hr />

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">1. Seleccionar Cliente</label>
            <select id="selectCliente" class="form-select"  asp-items="ViewBag.Clientes">
                <option value="">-- Seleccione un cliente --</option>
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold">2. Seleccionar Dirección de Entrega</label>
            <select id="selectDireccion" class="form-select" disabled>
                <option value="">-- Seleccione primero un cliente --</option>
            </select>
        </div>
    </div>


    <div class="row mb-4">
        <div class="col-md-6">
            <label class="form-label fw-bold">3. Cargar Producto (por ID)</label>
            <div class="input-group">
                <input type="number" id="inputProductoId" class="form-control" placeholder="Ingrese el id_producto" min="1" />
                <button class="btn btn-primary" id="btnAgregarProducto" type="button">Agregar Producto</button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped" id="tablaDetalles">
            <thead class="table-dark">
                <tr>
                    <th>Cantidad</th>
                    <th>Descripción</th>
                    <th>Costo Unitario</th>
                    <th>Subtotal</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody id="cuerpoTabla">
            </tbody>
        </table>
    </div>

    <div class="card mt-3 bg-light">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Usuario que realiza la operación:</strong> @(Context.Session.GetString("NombreUsuario") ?? "Admin/Usuario Predeterminado")</p>
                    <p class="mb-1"><strong>Total de productos cargados:</strong> <span id="lblTotalProductos">0</span></p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h4 class="mb-3">Monto total de la venta: $<span id="lblMontoTotal">0.00</span></h4>
                    <button id="btnConfirmarPedido" class="btn btn-success btn-lg">Confirmar Pedido</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script>
        let detallesPedido = [];
        let pedidoConfirmado = false;

        document.addEventListener('DOMContentLoaded', () => {
            const btnAgregar = document.getElementById('btnAgregarProducto');
            const btnConfirmar = document.getElementById('btnConfirmarPedido');

            btnAgregar.addEventListener('click', buscarYAgregarProducto);
            btnConfirmar.addEventListener('click', confirmarPedido);
        });

        const selectCliente = document.getElementById('selectCliente');
        const selectDireccion = document.getElementById('selectDireccion');

        selectCliente.addEventListener('change', async function () {
            const clienteId = this.value;

            if (!clienteId) {
                selectDireccion.disabled = true;
                selectDireccion.innerHTML = '<option value="">-- Seleccione primero un cliente --</option>';
                return;
            }

            try {
                const response = await fetch(`@Url.Action("ObtenerDireccionesCliente", "Pedidos")?clienteId=${clienteId}`);
                const direcciones = await response.json();

                if (direcciones.length > 0) {
                    selectDireccion.disabled = false;

                    selectDireccion.innerHTML = '';

                    direcciones.forEach(d => {
                        const option = document.createElement('option');
                        option.value = d.id;
                        option.textContent = d.texto;
                        selectDireccion.appendChild(option);
                    });
                } else {
                    selectDireccion.disabled = true;
                    selectDireccion.innerHTML = '<option value="0">Retira en Local</option>';
                }
            } catch (error) {
                console.error("Error al obtener direcciones:", error);
                alert("Ocurrió un error al buscar las direcciones del cliente.");
            }
        });

        async function buscarYAgregarProducto() {
            if (pedidoConfirmado) return;

            const inputId = document.getElementById('inputProductoId');
            const idProducto = parseInt(inputId.value);

            if (!idProducto || idProducto <= 0) {
                alert("Por favor, ingrese un ID de producto válido.");
                return;
            }

            const productoExistente = detallesPedido.find(p => p.productoId === idProducto);
            if (productoExistente) {
                productoExistente.cantidad++;
                productoExistente.subtotal = productoExistente.cantidad * productoExistente.costoUnitario;
                actualizarTabla();
                inputId.value = '';
                return;
            }

            try {
                const formData = new FormData();
                formData.append('idProducto', idProducto);

                const response = await fetch('@Url.Action("BuscarProducto", "Pedidos")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.exito) {
                    detallesPedido.push({
                        productoId: data.id,
                        descripcion: data.descripcion,
                        costoUnitario: data.precio,
                        cantidad: 1,
                        subtotal: data.precio
                    });
                    actualizarTabla();
                    inputId.value = '';
                } else {
                    alert(data.mensaje);
                }
            } catch (error) {
                console.error("Error al buscar el producto:", error);
                alert("Ocurrió un error al intentar buscar el producto.");
            }
        }

        function actualizarTabla() {
            const tbody = document.getElementById('cuerpoTabla');
            tbody.innerHTML = '';

            let totalProductos = 0;
            let montoTotal = 0;

            detallesPedido.forEach(item => {
                totalProductos += item.cantidad;
                montoTotal += item.subtotal;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center align-middle">
                        <button class="btn btn-sm btn-outline-secondary me-2" onclick="restarProducto(${item.productoId})" ${pedidoConfirmado ? 'disabled' : ''}>
                            <strong>-</strong>
                        </button>

                        <input type="number"
                               class="form-control form-control-sm text-center d-inline-block fw-bold"
                               style="width: 70px;"
                               min="1"
                               value="${item.cantidad}"
                               onchange="modificarCantidadManual(${item.productoId}, this.value)"
                               ${pedidoConfirmado ? 'disabled' : ''} />

                        <button class="btn btn-sm btn-outline-secondary ms-2" onclick="sumarProducto(${item.productoId})" ${pedidoConfirmado ? 'disabled' : ''}>
                            <strong>+</strong>
                        </button>
                    </td>
                    <td class="align-middle">${item.descripcion}</td>
                    <td class="align-middle">$${item.costoUnitario.toFixed(2)}</td>
                    <td class="align-middle">$${item.subtotal.toFixed(2)}</td>
                    <td class="align-middle">
                        <button class="btn btn-danger btn-sm" onclick="eliminarProducto(${item.productoId})" ${pedidoConfirmado ? 'disabled' : ''}>
                            Eliminar Fila
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('lblTotalProductos').innerText = totalProductos;
            document.getElementById('lblMontoTotal').innerText = montoTotal.toFixed(2);
        }

        window.modificarCantidadManual = function(idProducto, nuevaCantidadStr) {
            if (pedidoConfirmado) return;

            let nuevaCantidad = parseInt(nuevaCantidadStr);
            const producto = detallesPedido.find(p => p.productoId === idProducto);

            if (producto) {
                if (isNaN(nuevaCantidad) || nuevaCantidad < 1) {
                    alert("La cantidad debe ser un número válido mayor o igual a 1.");
                    nuevaCantidad = 1;
                }

                producto.cantidad = nuevaCantidad;
                producto.subtotal = producto.cantidad * producto.costoUnitario;
                actualizarTabla();
            }
        }

        window.restarProducto = function(idProducto) {
            if (pedidoConfirmado) return;

            const producto = detallesPedido.find(p => p.productoId === idProducto);

            if (producto) {
                if (producto.cantidad > 1) {
                    producto.cantidad--;
                    producto.subtotal = producto.cantidad * producto.costoUnitario;
                    actualizarTabla();
                } else {
                    eliminarProducto(idProducto);
                }
            }
        }

        window.eliminarProducto = function(idProducto) {
            if (pedidoConfirmado) return;

            detallesPedido = detallesPedido.filter(p => p.productoId !== idProducto);
            actualizarTabla();
        }

        window.sumarProducto = function(idProducto) {
            if (pedidoConfirmado) return;

            const producto = detallesPedido.find(p => p.productoId === idProducto);

            if (producto) {
                producto.cantidad++;
                producto.subtotal = producto.cantidad * producto.costoUnitario;
                actualizarTabla();
            }
        }

        async function confirmarPedido() {
            if (pedidoConfirmado) return;

            const clienteId = document.getElementById('selectCliente').value;
            const direccionId = document.getElementById('selectDireccion').value;

            if (!clienteId) {
                alert("Debe seleccionar un cliente antes de confirmar el pedido.");
                return;
            }
            
            if (detallesPedido.length === 0) {
                alert("El pedido no tiene productos cargados.");
                return;
            }

            if(direccionId === ""){
                alert("Debe seleccionar una direccion valida antes de confirmar el pedido");
                return;
            }

            const datosDelFrente = {
                ClienteId: parseInt(clienteId),
                
                DireccionId: parseInt(direccionId),

                MontoTotal: detallesPedido.reduce((acc, item) => acc + item.subtotal, 0),
                Detalles: detallesPedido.map(d => ({
                    ProductoId: d.productoId,
                    Cantidad: d.cantidad,
                    CostoUnitario: d.costoUnitario
                }))
            };

            try {
                const response = await fetch('@Url.Action("Confirmar", "Pedidos")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(datosDelFrente)
                });

                const data = await response.json();

                if (data.exito) {
                    alert(data.mensaje);
                    bloquearEdicion();
                } else {
                    alert(data.mensaje);
                }
            } catch (error) {
                console.error("Error al confirmar:", error);
                alert("Ocurrió un error grave al procesar el despacho.");
            }
        }

        function bloquearEdicion() {
            pedidoConfirmado = true;

            document.getElementById('selectCliente').disabled = true;
            document.getElementById('inputProductoId').disabled = true;
            document.getElementById('selectDireccion').disabled = true;
            document.getElementById('btnAgregarProducto').disabled = true;
            document.getElementById('btnConfirmarPedido').disabled = true;
            document.getElementById('btnConfirmarPedido').classList.replace('btn-success', 'btn-secondary');
            document.getElementById('btnConfirmarPedido').innerText = "Pedido Confirmado";

            const botonesEliminar = document.querySelectorAll('#cuerpoTabla .btn-danger');
            botonesEliminar.forEach(btn => btn.disabled = true);
            actualizarTabla();
        }
    </script>
}