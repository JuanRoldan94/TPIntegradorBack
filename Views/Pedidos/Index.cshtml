@model IEnumerable<TPIntegradorBack.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<h1>Pedidos</h1>

<div>
    <a class="btn btn-success mb-3" asp-action="Crear">Nuevo Pedido</a>
</div>

<form asp-controller="Pedidos" asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text"
                       name="buscarUsuario"
                       class="form-control"
                       placeholder="Buscar por nombre de usuario..."
                       value="@ViewBag.FiltroUsuario" />

                <button type="submit" class="btn btn-primary">
                    Buscar
                </button>

                <a asp-controller="Pedidos" asp-action="Index" class="btn btn-secondary">
                    Limpiar
                </a>
            </div>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Usuario</th>
            <th>Monto Total</th>
            <th>Productos</th>
            <th>Confirmado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Cliente?.RazonSocial</td>
                <td>@item.Usuario?.NombreUsuario</td>
                <td>$@item.MontoTotal.ToString("N2")</td>
                <td>@item.DetallePedido?.Sum(d => d.Cantidad)</td>
                <td>@(item.Confirmado ? "Sí" : "No")</td>
                <td>
                    <a class="btn btn-warning btn-sm" asp-action="Details" asp-route-id="@item.PedidoId">Ver</a>
                </td>
            </tr>
        }
    </tbody>

</table>
